# Copy to .env, replace SETUP_TOKEN with a random value of at least 32 characters.
# Alternatively run `npm run setup` to create .env with a generated token.
SETUP_TOKEN=
# Relative database paths resolve from the repository root, never from process cwd.
DATABASE_PATH=./data/studio.sqlite
PORT=3100
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Only local development may use insecure cookies. Use HTTPS + true when deployed.
COOKIE_SECURE=false
SESSION_HOURS=12
# 64 hex characters; npm run setup generates this without printing it.
# Keep this key when restoring a DB containing encrypted Provider credentials.
PROVIDER_MASTER_KEY=
# Media root defaults to a dedicated media/ directory next to DATABASE_PATH.
# Only the server operator configures this; the browser never supplies paths.
# MEDIA_ROOT=./data/media
MEDIA_MAX_BYTES=536870912
MEDIA_UPLOAD_TIMEOUT_MS=600000
# Optional absolute executable paths; otherwise PATH (or ignored local tools) is used.
# FFPROBE_PATH=
# FFMPEG_PATH=
